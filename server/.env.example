# Copy to .env to override defaults.
PORT=3010

# Where the SQLite database lives (defaults to server/data/truck-router.db).
# DATABASE_FILE=./data/truck-router.db

# Road-routing server. The default is OSRM's free public demo server, which is fine for
# testing but has no uptime guarantee and asks for light use. For production, self-host
# OSRM (https://github.com/Project-OSRM/osrm-backend) or use a hosted provider.
# OSRM_URL=https://router.project-osrm.org
